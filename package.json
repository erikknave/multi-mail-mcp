{
  "name": "multi-mail-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server giving access to multiple Gmail/Google Workspace and Microsoft 365/Outlook accounts: mail search, threads, calendars and attachments.",
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "hono": "^4.6.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
