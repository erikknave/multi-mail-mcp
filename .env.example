# ---- Server ----
PORT=8456
PUBLIC_BASE_URL=https://your-tunnel-hostname.example.com

# ---- Google OAuth ----
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Redirect URI must be: <PUBLIC_BASE_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft OAuth (optional) ----
# From Azure Portal -> Microsoft Entra ID -> App registrations -> your app.
# Leave both blank to run with Google accounts only.
# Redirect URI must be registered as type "Web" and be exactly:
#   <PUBLIC_BASE_URL>/oauth/microsoft/callback
# Delegated Graph permissions to grant: offline_access, openid, email, profile,
#   User.Read, Mail.ReadWrite, Mail.Send, Calendars.ReadWrite, Chat.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Which accounts may be connected. "organizations" = any work/school tenant
# (the default), a tenant id = only that tenant, "common" = also personal
# Microsoft accounts.
MICROSOFT_AUTHORITY=organizations

# ---- Who may sign in ----
# Comma-separated. Sign-in is Google-only — Microsoft can be connected as a
# mailbox but never used to sign in. These addresses may create a user.
ALLOWED_LOGIN_EMAILS=you@example.com

# ---- Secrets ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
URL_SIGNING_SECRET=

# ---- Storage ----
DATA_DIR=./data

# ---- Tuning ----
DOWNLOAD_URL_TTL=3600
UPLOAD_URL_TTL=3600
REAUTH_URL_TTL=86400
MAX_UPLOAD_BYTES=26214400
